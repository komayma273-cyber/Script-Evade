do
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

--==================================================
-- CONFIG
--==================================================

getgenv().BackJumpEnabled = false
getgenv().BackJumpSpeed = 40

local StepTime = 0.04
local AccelPerStep = 0.04

local LastStep = tick()
local AccumulatedTime = 0
local WasAirborne = false

local CurrentSpeed = getgenv().BackJumpSpeed
local CurrentVelocity = nil

local BackJumpFloatingButton = nil

--==================================================
-- HELPERS
--==================================================

local function roundOneDecimal(value)
    return math.floor(value * 10) / 10
end

local function getSpeedometer()
    local success, result = pcall(function()
        return LocalPlayer.PlayerGui
            .Shared
            .HUD
            .Overlay
            .Default
            .CharacterInfo
            .Item
            .Speedometer
            .Players
    end)

    if success then
        return result
    end

    return nil
end

--==================================================
-- STOP VELOCITY
--==================================================

local function ClearBackJumpVelocity()

    if CurrentVelocity then
        CurrentVelocity:Destroy()
        CurrentVelocity = nil
    end

end

--==================================================
-- ENABLE
--==================================================

local function EnableBackJump()

    getgenv().BackJumpEnabled = true

    CurrentSpeed =
        getgenv().BackJumpSpeed

    AccumulatedTime = 0
    WasAirborne = false

end

--==================================================
-- DISABLE
--==================================================

local function DisableBackJump()

    getgenv().BackJumpEnabled = false

    ClearBackJumpVelocity()

    CurrentSpeed =
        getgenv().BackJumpSpeed

    AccumulatedTime = 0
    WasAirborne = false

end

getgenv().EnableBackJump = EnableBackJump
getgenv().DisableBackJump = DisableBackJump

--==================================================
-- MAIN BACK JUMP LOOP
--==================================================

RunService.RenderStepped:Connect(function()

    local DeltaTime =
        tick() - LastStep

    LastStep = tick()

    local Character =
        LocalPlayer.Character

    if not Character then
        return
    end

    local RootPart =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not RootPart or not Humanoid then
        return
    end

    local Speedometer =
        getSpeedometer()

    local IsAirborne =
        Humanoid.FloorMaterial
        == Enum.Material.Air

    --==================================================
    -- LANDING RESET
    --==================================================

    if WasAirborne and not IsAirborne then

        CurrentSpeed =
            getgenv().BackJumpSpeed

        AccumulatedTime = 0

    end

    WasAirborne = IsAirborne

    --==================================================
    -- ENABLED
    --==================================================

    if getgenv().BackJumpEnabled then

        -- Acceleration
        if IsAirborne then

            AccumulatedTime =
                AccumulatedTime
                + DeltaTime

            while AccumulatedTime >= StepTime do

                AccumulatedTime =
                    AccumulatedTime
                    - StepTime

                CurrentSpeed =
                    math.min(
                        getgenv().BackJumpSpeed + 40,
                        CurrentSpeed + AccelPerStep
                    )

            end

        else

            AccumulatedTime = 0

            CurrentSpeed =
                getgenv().BackJumpSpeed

        end

        -- Force Jump
        local State =
            Humanoid:GetState()

        if State ~= Enum.HumanoidStateType.Jumping
            and State ~= Enum.HumanoidStateType.Freefall then

            Humanoid:ChangeState(
                Enum.HumanoidStateType.Jumping
            )

        end

        -- Remove previous velocity
        ClearBackJumpVelocity()

        --==================================================
        -- BACKWARD DIRECTION
        --==================================================

        local LookVector =
            -Camera.CFrame.LookVector

        local BackDirection =
            Vector3.new(
                LookVector.X,
                0,
                LookVector.Z
            )

        if BackDirection.Magnitude > 0 then
            BackDirection =
                BackDirection.Unit
        end

        --==================================================
        -- BODY VELOCITY
        --==================================================

        local BodyVelocity =
            Instance.new("BodyVelocity")

        BodyVelocity.Name =
            "KRYVEX_BackJumpVelocity"

        BodyVelocity.Velocity =
            BackDirection * CurrentSpeed

        BodyVelocity.MaxForce =
            Vector3.new(
                400000,
                0,
                400000
            )

        BodyVelocity.P = 1250
        BodyVelocity.Parent = RootPart

        Debris:AddItem(
            BodyVelocity,
            0.1
        )

        CurrentVelocity =
            BodyVelocity

        --==================================================
        -- SPEEDOMETER
        --==================================================

        if Speedometer then

            Speedometer.Text =
                tostring(
                    roundOneDecimal(
                        CurrentSpeed
                    )
                )

        end

    else

        ClearBackJumpVelocity()

        CurrentSpeed =
            getgenv().BackJumpSpeed

        AccumulatedTime = 0
        WasAirborne = false

    end

end)

--==================================================
-- FLOATING BUTTON
--==================================================

local function CreateBackJumpFloatingButton()

    -- ถ้ามีอยู่แล้วไม่สร้างซ้ำ
