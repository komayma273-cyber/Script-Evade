--// KRYVEX HUB | Remove Darkness
--// ครอบด้วย task.spawn(function() ... end) เพื่อไม่ให้ใช้ตัวแปร local ของไฟล์หลัก
--// (สคริปต์หลักมี local ระดับบนสุดเกือบเต็มลิมิต 200 ตัวแล้ว)
task.spawn(function()
    local Lighting = game:GetService("Lighting")

    local DarknessEnabled = false
    local OriginalLighting = {}
    local OriginalEffects = {}

    local function EnableRemoveDarkness()
        if DarknessEnabled then
            return
        end

        DarknessEnabled = true

        OriginalLighting = {
            GlobalShadows = Lighting.GlobalShadows,
            Brightness = Lighting.Brightness,
            ExposureCompensation = Lighting.ExposureCompensation,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            ClockTime = Lighting.ClockTime,
            FogEnd = Lighting.FogEnd,
            FogStart = Lighting.FogStart
        }

        Lighting.GlobalShadows = false
        Lighting.Brightness = 3
        Lighting.ExposureCompensation = 0.5
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
        Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
        Lighting.FogStart = 0
        Lighting.FogEnd = 1000000

        OriginalEffects = {}

        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then
                OriginalEffects[effect] = effect.Enabled

                if effect:IsA("ColorCorrectionEffect")
                    or effect:IsA("BlurEffect")
                    or effect:IsA("SunRaysEffect") then
                    effect.Enabled = false
                end
            end
        end
    end

    local function DisableRemoveDarkness()
        if not DarknessEnabled then
            return
        end

        DarknessEnabled = false

        for property, value in pairs(OriginalLighting) do
            Lighting[property] = value
        end

        for effect, wasEnabled in pairs(OriginalEffects) do
            if effect and effect.Parent == Lighting then
                effect.Enabled = wasEnabled
            end
        end

        OriginalLighting = {}
        OriginalEffects = {}
    end

