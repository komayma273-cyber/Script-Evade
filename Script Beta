do
    local function FormatNumber(Value)
        Value = tostring(Value or "")
        Value = Value:gsub("[^%d]", "")

        if Value == "" then
            return nil
        end

        local Result = Value

        while true do
            local NewResult, Count = Result:gsub("^(%d+)(%d%d%d)", "%1,%2")
            Result = NewResult

            if Count == 0 then
                break
            end
        end

        return Result
    end

