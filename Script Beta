--=========================================================
-- KRYVEX HUB | LOW GRAPHICS
-- Batch Scan + Material Correction
--=========================================================

do
    local LowGraphicsEnabled = false
    local LowGraphicsConnection = nil
    local LowGraphicsWorker = false

    local ScanInterval = 1.5
    local BatchSize = 100

    local function OptimizePart(Object)
        if not LowGraphicsEnabled then
            return
        end

        if not Object:IsA("BasePart") then
            return
        end

        pcall(function()
            if Object.Material ~= Enum.Material.SmoothPlastic then
                Object.Material = Enum.Material.SmoothPlastic
            end

            if Object.Reflectance ~= 0 then
                Object.Reflectance = 0
            end
        end)
    end

    --=====================================================
    -- BATCH SCAN ENTIRE MAP
    --=====================================================

    local function ScanWorkspace()
        if LowGraphicsWorker then
            return
        end

        LowGraphicsWorker = true

        task.spawn(function()
            local Success, ErrorMessage = pcall(function()
                local Objects = workspace:GetDescendants()
                local Index = 1

                while LowGraphicsEnabled and Index <= #Objects do
                    local EndIndex = math.min(
                        Index + BatchSize - 1,
                        #Objects
                    )

                    for i = Index, EndIndex do
                        if not LowGraphicsEnabled then
                            break
                        end

                        OptimizePart(Objects[i])
                    end

                    Index = EndIndex + 1

                    -- Yield between batches to reduce frame spikes
                    task.wait()
                end
            end)

            LowGraphicsWorker = false

            if not Success then
                warn("[KRYVEX LowGraphics] Scan error:", ErrorMessage)
            end
        end)
    end

    --=====================================================
    -- START
    --=====================================================

    local function StartLowGraphics()
        LowGraphicsEnabled = true

        if LowGraphicsConnection then
            LowGraphicsConnection:Disconnect()
            LowGraphicsConnection = nil
        end

        -- Handle newly added parts
        LowGraphicsConnection = workspace.DescendantAdded:Connect(function(Object)
            if not LowGraphicsEnabled then
                return
            end

            task.defer(function()
                OptimizePart(Object)
            end)
        end)

        ScanWorkspace()

        -- Periodically rescan in case the game restores materials
        task.spawn(function()
            while LowGraphicsEnabled do
                task.wait(ScanInterval)

                if LowGraphicsEnabled then
                    ScanWorkspace()
                end
            end
        end)
    end

    --=====================================================
    -- STOP
    --=====================================================

    local function StopLowGraphics()
        LowGraphicsEnabled = false

        if LowGraphicsConnection then
            LowGraphicsConnection:Disconnect()
            LowGraphicsConnection = nil
        end
    end

    --=====================================================
    -- UI
    --=====================================================

    OtherTab:CreateSection("ประสิทธิภาพ")

    OtherTab:CreateToggle({
        Name = "ลดกราฟฟิค",
        Default = false,

        Callback = function(Value)
            if Value then
                StartLowGraphics()
            else
                StopLowGraphics()
            end

            Window:Notify({
                Title = "KRYVEX HUB",
                Content = Value
                    and "เปิดลดกราฟฟิคแล้ว"
                    or "ปิดลดกราฟฟิคแล้ว",
                Duration = 3
            })
        end
    })
end


--=========================================================
-- KRYVEX HUB | RESCUE TELEPORT V2
-- Find Downed -> Carry -> Return
--=========================================================

do
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local Player = Players.LocalPlayer
    local Interact = ReplicatedStorage
        :WaitForChild("Events")
        :WaitForChild("Interact")

    local RescueBusy = false
    local RescueDelay = 3
    local RescueFloatingHandle = nil

    --=====================================================
    -- NOTIFY
    --=====================================================

    local function Notify(Message)
        pcall(function()
            Window:Notify({
                Title = "KRYVEX HUB",
                Content = Message,
                Duration = 3
            })
        end)
    end

    --=====================================================
    -- GET CHARACTER
    --=====================================================

    local function GetCharacterParts()
        local Character = Player.Character
        if not Character then return end

        local Root = Character:FindFirstChild("HumanoidRootPart")
            or Character.PrimaryPart

        local Humanoid = Character:FindFirstChildWhichIsA(
            "Humanoid",
            true
        )

        if not Root or not Humanoid or Humanoid.Health <= 0 then
            return
        end

        return Character, Root, Humanoid
    end

    --=====================================================
    -- GET TARGET TAG
    --=====================================================

    local function GetTargetTag(Target)
        local Tag = Target:GetAttribute("Tag")

        if Tag == nil then
            Tag = Target:GetAttribute("ID")
        end

        if Tag == nil then
            Tag = Target.Name
        end

        if typeof(Tag) == "number" then
            return Tag
        end

        if typeof(Tag) == "string" and Tag ~= "" then
            return tonumber(Tag) or Tag
        end

        return nil
    end

    --=====================================================
    -- FIND DOWNED PLAYERS
    --=====================================================

    local function FindDownedPlayers(Origin)
        local Targets = {}

        local Folder = workspace:FindFirstChild("Players")

        if not Folder then
            warn("[KRYVEX Rescue] workspace.Players not found")
            return Targets
        end

        for _, Model in ipairs(Folder:GetChildren()) do
            if Model:IsA("Model") and Model ~= Player.Character then
                local Humanoid = Model:FindFirstChildWhichIsA(
                    "Humanoid",
                    true
                )

                local Root = Model:FindFirstChild("HumanoidRootPart", true)
                    or Model.PrimaryPart

                -- ไม่บังคับให้มี Tag ตอนค้นหา
                if Humanoid and Humanoid.Health <= 0 and Root then
                    table.insert(Targets, {
                        Model = Model,
                        Humanoid = Humanoid,
                        Root = Root,
                        Tag = GetTargetTag(Model),
                        Distance = (Root.Position - Origin).Magnitude
                    })
                end
            end
        end

        table.sort(Targets, function(A, B)
            return A.Distance < B.Distance
        end)

        return Targets
    end

    --=====================================================
    -- CHECK CARRY JOINT
    --=====================================================

    local function BelongsTo(Model, Part)
        return Part
            and Part:IsA("BasePart")
            and Part:IsDescendantOf(Model)
    end

    local function IsConnectedCarry(Character, Target)
        local function CheckObject(Object)
            local Part0, Part1

            if Object:IsA("JointInstance")
                or Object:IsA("WeldConstraint") then

                Part0 = Object.Part0
                Part1 = Object.Part1

            elseif Object:IsA("Constraint") then
                local A, B

                pcall(function()
                    A = Object.Attachment0
                    B = Object.Attachment1
                end)

                Part0 = A and A.Parent
                Part1 = B and B.Parent
            else
                return false
            end

            return (
                BelongsTo(Character, Part0)
                and BelongsTo(Target, Part1)
            ) or (
                BelongsTo(Target, Part0)
                and BelongsTo(Character, Part1)
            )
        end

        for _, Object in ipairs(Character:GetDescendants()) do
            if CheckObject(Object) then
                return true
            end
        end

        for _, Object in ipairs(Target:GetDescendants()) do
            if CheckObject(Object) then
                return true
            end
        end

        return false
    end

    --=====================================================
    -- TELEPORT
    --=====================================================

    local function ReturnToOrigin(OriginCFrame)
        local Character = Player.Character
        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        if Root and OriginCFrame then
            pcall(function()
                Root.CFrame = OriginCFrame
            end)
        end
    end

    --=====================================================
    -- RESCUE
    --=====================================================

    local function RescueDownedPlayers()
        if RescueBusy then
            Notify("กำลังช่วยผู้เล่นอยู่")
            return
        end

        local Character, Root = GetCharacterParts()

        if not Character or not Root then
            Notify("ไม่พบตัวละครที่พร้อมใช้งาน")
            return
        end

        local OriginCFrame = Root.CFrame
        local Targets = FindDownedPlayers(Root.Position)

        if #Targets == 0 then
            Notify("ไม่พบผู้เล่นที่เลือดเหลือ 0 ใน workspace.Players")
            return
        end

        RescueBusy = true

        task.spawn(function()
            local Carried = false
            local Failed = false

            local OK, ErrorMessage = pcall(function()
                for _, Info in ipairs(Targets) do
                    if Player.Character ~= Character then
                        break
                    end

                    local Target = Info.Model
                    local Humanoid = Info.Humanoid
                    local TargetRoot = Info.Root
                    local Tag = Info.Tag

                    if not Target.Parent
                        or not Humanoid.Parent
                        or not TargetRoot.Parent
                        or Humanoid.Health > 0 then
                        continue
                    end

                    if Tag == nil then
                        warn("[KRYVEX Rescue] Missing target Tag:", Target:GetFullName())
                        continue
                    end

                    Notify("กำลังไปหา: " .. Target.Name)

                    local TeleportOK = pcall(function()
                        Root.CFrame = TargetRoot.CFrame
                            * CFrame.new(0, 0, 3)
                    end)

                    if not TeleportOK then
                        continue
                    end

                    task.wait(0.2)

                    if Player.Character ~= Character then
                        break
                    end

                    if not Target.Parent or Humanoid.Health > 0 then
                        continue
                    end

                    -- ส่งคำสั่งอุ้มหนึ่งครั้งต่อเป้าหมาย
                    local Sent = pcall(function()
                        Interact:FireServer("Carry", Tag)
                    end)

                    if not Sent then
                        continue
                    end

                    local Started = os.clock()

                    while os.clock() - Started < RescueDelay do
                        if Player.Character ~= Character then
                            break
                        end

                        if not Target.Parent or not TargetRoot.Parent then
                            break
                        end

                        if IsConnectedCarry(Character, Target) then
                            Carried = true
                            break
                        end

                        task.wait(0.15)
                    end

                    if Carried then
                        Notify("อุ้มสำเร็จ กำลังกลับจุดเดิม")
                        break
                    end
                end
            end)

            -- กลับจุดเดิมหลังจบการช่วย
            if Player.Character == Character then
                ReturnToOrigin(OriginCFrame)
            end

            RescueBusy = false

            if not OK then
                warn("[KRYVEX Rescue]", ErrorMessage)
                Notify("เกิดข้อผิดพลาดระหว่างช่วยผู้เล่น")
            elseif Carried then
                Notify("กลับจุดเดิมแล้ว")
            else
                Notify("ไม่มีเป้าหมายที่อุ้มสำเร็จ")
            end
        end)
    end

    --=====================================================
    -- TELEPORT TAB BUTTON
    --=====================================================

    TeleportTab:CreateButton({
        Name = "วาร์ปไปเก็บผู้เล่นที่ล้ม",
        Callback = function()
            RescueDownedPlayers()
        end
    })

    --=====================================================
    -- FLOATING BUTTON TOGGLE
    --=====================================================

    TeleportTab:CreateToggle({
        Name = "ช่วยผู้เล่นที่ล้ม (ปุ่มลอย)",
        Default = false,

        Callback = function(Value)
            if Value then
                if RescueFloatingHandle then
                    RescueFloatingHandle:Destroy()
                    RescueFloatingHandle = nil
                end

                RescueFloatingHandle = CreateFloatingButton({
                    Name = "ช่วยคนล้ม",
                    Mode = "Button",
                    OnText = "ช่วยคนล้ม",
                    OffText = "ช่วยคนล้ม",

                    Callback = function()
                        RescueDownedPlayers()
                    end
                })
            else
                if RescueFloatingHandle then
                    RescueFloatingHandle:Destroy()
                    RescueFloatingHandle = nil
                end

                RemoveFloatingButton("ช่วยคนล้ม")
            end
        end
    })
end


--========================================================
-- KRYVEX HUB | ESP SUITE
-- Bot ESP / Player ESP / Downed ESP
--========================================================
do
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LP = LocalPlayer or Players.LocalPlayer

    local UPDATE_INTERVAL = 0.20
    local OUTLINE_COLOR = Color3.fromRGB(65, 65, 65)
    local TEXT_COLOR = Color3.fromRGB(225, 225, 225)
    local RED_COLOR = Color3.fromRGB(255, 65, 65)

    local BotEnabled = false
    local PlayerEnabled = false
    local DownedEnabled = false

    local BotConnection
    local PlayerConnection
    local DownedConnection

    local BotData = {}
    local PlayerData = {}
    local DownedData = {}

    local BotFolder
    local PlayerFolder
    local DownedFolder

    local BotSky
    local BotSkyAttachment

    local PlayerSky
    local PlayerSkyAttachment

    local DownedSky
    local DownedSkyAttachment

    local PlayerAddedConnection
    local PlayerRemovingConnection

    --====================================================
    -- UTILITIES
    --====================================================

    local function GetParent()
        local OK, Result = pcall(function()
            if gethui then
                return gethui()
            end
            return LP:WaitForChild("PlayerGui")
        end)

        if OK and Result then
            return Result
        end

        return LP:WaitForChild("PlayerGui")
    end

    local function NewFolder(Name)
        local Folder = Instance.new("Folder")
        Folder.Name = Name
        Folder.Parent = GetParent()
        return Folder
    end

    local function DestroyObject(Object)
        if Object then
            pcall(function()
                Object:Destroy()
            end)
        end
    end

    local function DestroyData(DataTable, Key)
        local Data = DataTable[Key]
        if not Data then
            return
        end

        DataTable[Key] = nil

        for _, Object in pairs(Data) do
            if typeof(Object) == "Instance" then
                DestroyObject(Object)
            end
        end
    end

    local function ClearData(DataTable)
        local Keys = {}

        for Key in pairs(DataTable) do
            Keys[#Keys + 1] = Key
        end

        for _, Key in ipairs(Keys) do
            DestroyData(DataTable, Key)
        end
    end

    local function CreateSky(Name, Height)
        local Part = Instance.new("Part")
        Part.Name = Name
        Part.Size = Vector3.new(0.1, 0.1, 0.1)
        Part.Transparency = 1
        Part.Anchored = true
        Part.CanCollide = false
        Part.CanTouch = false
        Part.CanQuery = false
        Part.Parent = workspace

        local Attachment = Instance.new("Attachment")
        Attachment.Parent = Part

        return Part, Attachment, Height
    end

    local function UpdateSky(Part, Height)
        if not Part then
            return
        end

        local Character = LP.Character
        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        if Root then
            Part.CFrame = CFrame.new(
                Root.Position + Vector3.new(0, Height, 0)
            )
        end
    end

    local function CreateLabel(Parent, Name, Text, Color, Height, Y)
        local Label = Instance.new("TextLabel")
        Label.Name = Name
        Label.Size = UDim2.new(1, 0, 0, Height)
        Label.Position = UDim2.fromOffset(0, Y)
        Label.BackgroundTransparency = 1
        Label.BorderSizePixel = 0
        Label.Text = Text
        Label.TextColor3 = Color
        Label.TextStrokeColor3 = Color3.fromRGB(15, 15, 15)
        Label.TextStrokeTransparency = 0.3
        Label.TextScaled = true
        Label.Font = Enum.Font.GothamBold
        Label.Parent = Parent
        return Label
    end

    local function CreateHighlight(Model, Parent, Name)
        local Highlight = Instance.new("Highlight")
        Highlight.Name = Name
        Highlight.Adornee = Model
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        Highlight.FillTransparency = 1
        Highlight.OutlineTransparency = 0
        Highlight.OutlineColor = OUTLINE_COLOR

        -- ผูกกับโมเดลเพื่อให้แสดงขอบตัวละคร
        Highlight.Parent = Model

        return Highlight
    end

    --====================================================
    -- BOT ESP
    --====================================================

    local function GetBotHitbox(Rig)
        local Hitbox = Rig:FindFirstChild("Hitbox", true)

        if Hitbox and Hitbox:IsA("BasePart") then
            return Hitbox
        end

        return nil
    end

    local function RemoveBot(Rig)
        DestroyData(BotData, Rig)
    end

    local function CreateBot(Rig)
        if BotData[Rig] then
            return
        end

        local Hitbox = GetBotHitbox(Rig)
        if not Hitbox or not BotFolder then
            return
        end

        local OK, Data = pcall(function()
            local Gui = Instance.new("BillboardGui")
            Gui.Name = "KRYVEX_BotName"
            Gui.Adornee = Hitbox
            Gui.Size = UDim2.fromOffset(180, 48)
            Gui.StudsOffset = Vector3.new(0, 4, 0)
            Gui.AlwaysOnTop = true
            Gui.MaxDistance = 10000
            Gui.Parent = BotFolder

            CreateLabel(
                Gui,
                "BotTitle",
                "⚠ " .. Rig.Name,
                TEXT_COLOR,
                28,
                0
            )

            CreateLabel(
                Gui,
                "BotStatus",
                "NEXTBOT • DETECTED",
                Color3.fromRGB(190, 190, 190),
                17,
                29
            )

            local SkyAttachment = BotSkyAttachment
            local BotAttachment = Instance.new("Attachment")
            BotAttachment.Parent = Hitbox

            local Beam = Instance.new("Beam")
            Beam.Name = "KRYVEX_BotLine"
            Beam.Attachment0 = SkyAttachment
            Beam.Attachment1 = BotAttachment
            Beam.Width0 = 0.08
            Beam.Width1 = 0.08
            Beam.FaceCamera = true
            Beam.LightEmission = 1
            Beam.LightInfluence = 0
            Beam.Transparency = NumberSequence.new(0.1)
            Beam.Color = ColorSequence.new(TEXT_COLOR)
            Beam.Parent = BotSky

            return {
                Gui = Gui,
                Beam = Beam,
                Attachment = BotAttachment,
            }
        end)

        if OK and Data then
            BotData[Rig] = Data
        end
    end

    local function UpdateBots()
        if not BotEnabled then
            return
        end

        local Rigs = workspace:FindFirstChild("Rigs")
        if not Rigs then
            return
        end

        local Seen = {}

        for _, Rig in ipairs(Rigs:GetChildren()) do
            local Hitbox = GetBotHitbox(Rig)

            if Hitbox then
                Seen[Rig] = true

                local Data = BotData[Rig]
                if Data and (
                    not Data.Gui
                    or not Data.Gui.Parent
                    or not Data.Attachment
                    or Data.Attachment.Parent ~= Hitbox
                ) then
                    RemoveBot(Rig)
                    Data = nil
                end

                if not Data then
                    CreateBot(Rig)
                end

                local Current = BotData[Rig]
                if Current and Current.Beam then
                    Current.Beam.Enabled = true
                end
            end
        end

        for Rig in pairs(BotData) do
            if not Seen[Rig] then
                RemoveBot(Rig)
            end
        end
    end

    local function StopBots()
        BotEnabled = false

        if BotConnection then
            BotConnection:Disconnect()
            BotConnection = nil
        end

        ClearData(BotData)

        DestroyObject(BotFolder)
        BotFolder = nil

        DestroyObject(BotSky)
        BotSky = nil
        BotSkyAttachment = nil
    end

    local function StartBots()
        StopBots()

        BotEnabled = true
        BotFolder = NewFolder("KRYVEX_BotESP")
        BotSky, BotSkyAttachment = CreateSky(
            "KRYVEX_BotSky",
            60
        )

        UpdateBots()

        local Last = 0
        BotConnection = RunService.Heartbeat:Connect(function()
            if not BotEnabled then
                return
            end

            UpdateSky(BotSky, 60)

            if os.clock() - Last >= UPDATE_INTERVAL then
                Last = os.clock()
                UpdateBots()
            end
        end)
    end

    --====================================================
    -- PLAYER / DOWNED ESP
    --====================================================

    local function CreatePlayerESP(Player, IsDowned)
        local Character = Player.Character
        local Humanoid = Character
            and Character:FindFirstChildOfClass("Humanoid")
        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        if not Character or not Humanoid or not Root then
            return nil
        end

        local Folder = IsDowned and DownedFolder or PlayerFolder
        if not Folder then
            return nil
        end

        local OK, Data = pcall(function()
            local Highlight = CreateHighlight(
                Character,
                Folder,
                IsDowned
                    and "KRYVEX_DownedHighlight"
                    or "KRYVEX_PlayerHighlight"
            )

            local Gui = Instance.new("BillboardGui")
            Gui.Name = IsDowned
                and "KRYVEX_DownedName"
                or "KRYVEX_PlayerName"
            Gui.Adornee = Root
            Gui.Size = UDim2.fromOffset(
                190,
                IsDowned and 36 or 24
            )
            Gui.StudsOffset = Vector3.new(0, 3.5, 0)
            Gui.AlwaysOnTop = true
            Gui.MaxDistance = 10000
            Gui.Parent = Folder

            CreateLabel(
                Gui,
                "PlayerName",
                Player.DisplayName,
                TEXT_COLOR,
                22,
                0
            )

            local Status
            if IsDowned then
                Status = CreateLabel(
                    Gui,
                    "DownedStatus",
                    "● ล้ม",
                    RED_COLOR,
                    15,
                    21
                )
            end

            return {
                Character = Character,
                Root = Root,
                Humanoid = Humanoid,
                Highlight = Highlight,
                Gui = Gui,
                Status = Status,
            }
        end)

        if OK then
            return Data
        end

        return nil
    end

    local function UpdatePlayers(IsDowned)
        local Enabled = IsDowned and DownedEnabled or PlayerEnabled
        if not Enabled then
            return
        end

        local DataTable = IsDowned and DownedData or PlayerData
        local Seen = {}

        for _, Player in ipairs(Players:GetPlayers()) do
            if Player ~= LP then
                local Character = Player.Character
                local Humanoid = Character
                    and Character:FindFirstChildOfClass("Humanoid")
                local Root = Character
                    and Character:FindFirstChild("HumanoidRootPart")

                local Valid = Character
                    and Character.Parent
                    and Humanoid
                    and Root
                    and Root:IsA("BasePart")

                if IsDowned then
                    Valid = Valid and Humanoid.Health <= 0
                end

                local Data = DataTable[Player]

                if Data and (
                    not Valid
                    or Data.Character ~= Character
                    or Data.Root ~= Root
                    or Data.Humanoid ~= Humanoid
                    or not Data.Gui
                    or not Data.Gui.Parent
                    or not Data.Highlight
                    or not Data.Highlight.Parent
                ) then
                    DestroyData(DataTable, Player)
                    Data = nil
                end

                if Valid then
                    Seen[Player] = true

                    if not Data then
                        DataTable[Player] =
                            CreatePlayerESP(Player, IsDowned)
                    end
                end
            end
        end

        for Player in pairs(DataTable) do
            if not Seen[Player] then
                DestroyData(DataTable, Player)
            end
        end
    end

    local function StartPlayers(IsDowned)
        local Folder

        if IsDowned then
            DownedEnabled = false
            ClearData(DownedData)
            DestroyObject(DownedFolder)

            DownedFolder = NewFolder("KRYVEX_DownedESP")
            DownedEnabled = true
            Folder = DownedFolder
        else
            PlayerEnabled = false
            ClearData(PlayerData)
            DestroyObject(PlayerFolder)

            PlayerFolder = NewFolder("KRYVEX_PlayerESP")
            PlayerEnabled = true
            Folder = PlayerFolder
        end

        UpdatePlayers(IsDowned)
    end

    local function StopPlayers(IsDowned)
        if IsDowned then
            DownedEnabled = false
            ClearData(DownedData)
            DestroyObject(DownedFolder)
            DownedFolder = nil
        else
            PlayerEnabled = false
            ClearData(PlayerData)
            DestroyObject(PlayerFolder)
            PlayerFolder = nil
        end
    end

    local function EnsurePlayerLoop()
        if PlayerConnection then
            PlayerConnection:Disconnect()
        end

        local Last = 0
        PlayerConnection = RunService.Heartbeat:Connect(function()
            if not PlayerEnabled and not DownedEnabled then
                PlayerConnection:Disconnect()
                PlayerConnection = nil
                return
            end

            UpdateSky(PlayerSky, 25)
            UpdateSky(DownedSky, 25)

            if os.clock() - Last >= UPDATE_INTERVAL then
                Last = os.clock()

                if PlayerEnabled then
                    UpdatePlayers(false)
                end

                if DownedEnabled then
                    UpdatePlayers(true)
                end
            end
        end)
    end

    local function SetPlayers(Value)
        if Value then
            if not PlayerFolder then
                PlayerFolder = NewFolder("KRYVEX_PlayerESP")
            end

            if not PlayerSky then
                PlayerSky, PlayerSkyAttachment = CreateSky(
                    "KRYVEX_PlayerSky",
                    25
                )
            end

            PlayerEnabled = true
            UpdatePlayers(false)
            EnsurePlayerLoop()
        else
            StopPlayers(false)

            if not DownedEnabled then
                DestroyObject(PlayerSky)
                PlayerSky = nil
                PlayerSkyAttachment = nil
            end
        end
    end

    local function SetDowned(Value)
        if Value then
            if not DownedFolder then
                DownedFolder = NewFolder("KRYVEX_DownedESP")
            end

            if not DownedSky then
                DownedSky, DownedSkyAttachment = CreateSky(
                    "KRYVEX_DownedSky",
                    25
                )
            end

            DownedEnabled = true
            UpdatePlayers(true)
            EnsurePlayerLoop()
        else
            StopPlayers(true)

            if not PlayerEnabled then
                DestroyObject(DownedSky)
                DownedSky = nil
                DownedSkyAttachment = nil
            end
        end
    end

    --====================================================
    -- PLAYER JOIN / LEAVE
    --====================================================

    PlayerRemovingConnection = Players.PlayerRemoving:Connect(function(Player)
        DestroyData(PlayerData, Player)
        DestroyData(DownedData, Player)
    end)

    --====================================================
    -- UI
    --====================================================

    VisualTab:CreateSection("มองหาบอท")

    VisualTab:CreateToggle({
        Name = "มองหาบอท",
        Default = false,
        Callback = function(Value)
            if Value then
                StartBots()
            else
                StopBots()
            end

            Window:Notify({
                Title = "KRYVEX HUB",
                Content = Value
                    and "เปิดระบบมองหาบอทแล้ว"
                    or "ปิดระบบมองหาบอทแล้ว",
                Duration = 3
            })
        end
    })

    VisualTab:CreateSection("มองหาผู้เล่น")

    VisualTab:CreateToggle({
        Name = "มองหาผู้เล่นทั้งหมด",
        Default = false,
        Callback = function(Value)
            SetPlayers(Value)

            Window:Notify({
                Title = "KRYVEX HUB",
                Content = Value
                    and "เปิดมองหาผู้เล่นทั้งหมดแล้ว"
                    or "ปิดมองหาผู้เล่นทั้งหมดแล้ว",
                Duration = 3
            })
        end
    })

    VisualTab:CreateSection("มองหาผู้เล่นล้ม")

    VisualTab:CreateToggle({
        Name = "มองหาผู้เล่นล้ม",
        Default = false,
        Callback = function(Value)
            SetDowned(Value)

            Window:Notify({
                Title = "KRYVEX HUB",
                Content = Value
                    and "เปิดมองหาผู้เล่นล้มแล้ว"
                    or "ปิดมองหาผู้เล่นล้มแล้ว",
                Duration = 3
            })
        end
    })
end
