    local SavedSky = nil

    local OwnAtmo = nil
    local OwnSky = nil

    local CreatedEffects = {}
    local ClockConnection = nil
    local StormToken = 0

    local Selected = Order[1]

    local function Snapshot(Object, Properties)
        local Data = {}

        for _, Property in ipairs(Properties) do
            local Success, Value = pcall(function()
                return Object[Property]
            end)

            if Success then
                Data[Property] = Value
            end
        end

        return Data
    end

    local function Apply(Object, Data)
        for Property, Value in pairs(Data) do
            pcall(function()
                Object[Property] = Value
            end)
        end
    end

    local function DestroyObject(Object)
        if Object then
            pcall(function()
                Object:Destroy()
            end)
        end
    end

    local function ClearEffects()
        StormToken += 1

        if ClockConnection then
            ClockConnection:Disconnect()
            ClockConnection = nil
        end

        for _, Object in ipairs(CreatedEffects) do
            DestroyObject(Object)
        end

        CreatedEffects = {}
    end

    local function AddEffect(ClassName, Name, Properties)
        local Effect = Instance.new(ClassName)

        Effect.Name = Name

        Apply(Effect, Properties)

        Effect.Parent = Lighting

        CreatedEffects[#CreatedEffects + 1] = Effect

        return Effect
    end

    local function SaveOriginalEnvironment()
        if not SavedLighting then
            SavedLighting = Snapshot(Lighting, LightingProps)
        end

        if not SavedAtmo then
            local Atmo = Lighting:FindFirstChildOfClass("Atmosphere")

            if Atmo then
                SavedAtmo = Snapshot(Atmo, AtmoProps)
            end
        end

        if not SavedSky then
            local Sky = Lighting:FindFirstChildOfClass("Sky")

            if Sky then
                SavedSky = Snapshot(Sky, SkyProps)
            end
        end
    end

    local function RemoveOwnedEnvironment()
        if OwnAtmo then
            DestroyObject(OwnAtmo)
            OwnAtmo = nil
        end

        if OwnSky then
            DestroyObject(OwnSky)
            OwnSky = nil
        end
    end

    local function Restore()
        ClearEffects()

        RemoveOwnedEnvironment()

        if SavedLighting then
            Apply(Lighting, SavedLighting)
        end

        if SavedAtmo then
            local Atmo = Lighting:FindFirstChildOfClass("Atmosphere")

            if Atmo then
                Apply(Atmo, SavedAtmo)
            end
        end

        if SavedSky then
            local Sky = Lighting:FindFirstChildOfClass("Sky")

            if Sky then
                Apply(Sky, SavedSky)
            end
        end

        SavedLighting = nil
        SavedAtmo = nil
        SavedSky = nil
    end

    local function PrepareAtmosphere(Theme)
        local Atmo = Lighting:FindFirstChildOfClass("Atmosphere")

        if not Atmo then
            Atmo = Instance.new("Atmosphere")
            Atmo.Name = "KOMAT_SkyAtmosphere"
            Atmo.Parent = Lighting
            OwnAtmo = Atmo
        end

        Apply(Atmo, Theme.Atmo)
    end

    local function PrepareSky(Theme)
        if Theme.Sky then
            local Sky = Lighting:FindFirstChildOfClass("Sky")

            if not Sky then
                Sky = Instance.new("Sky")
                Sky.Name = "KOMAT_Sky"
                Sky.Parent = Lighting
                OwnSky = Sky
            end

            Apply(Sky, Theme.Sky)
        else
            if OwnSky then
                DestroyObject(OwnSky)
                OwnSky = nil
            end
        end
    end

    local function ApplyTheme(Theme)
        if not Theme then
            return
        end

        SaveOriginalEnvironment()

        ClearEffects()

        Apply(Lighting, Theme.Lighting)

        Lighting.ClockTime = Theme.Time

        PrepareAtmosphere(Theme)

        PrepareSky(Theme)

