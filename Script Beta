do
local AutoBounce = false
local AutoBounceHeight = 150
local AutoBounceDistance = 7

local AutoBounceConnection = nil
local AutoBounceCooldown = false

local function GetCharacterData()
    local Character = LocalPlayer.Character

    if not Character then
        return nil
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Humanoid or not Root then
        return nil
    end

    return Character, Humanoid, Root
end

local function CheckGroundDistance(
    Character,
    Root
)
    local Params =
        RaycastParams.new()

    Params.FilterType =
        Enum.RaycastFilterType.Exclude

    Params.FilterDescendantsInstances = {
        Character
    }

    Params.IgnoreWater = true

    local Result =
        workspace:Raycast(
            Root.Position,
            Vector3.new(
                0,
                -AutoBounceDistance,
                0
            ),
            Params
        )

    if Result then
        return (
            Root.Position
            - Result.Position
        ).Magnitude
    end

    return nil
end

local function DoAutoBounce(
    Humanoid,
    Root
)
    if AutoBounceCooldown then
        return
    end

    AutoBounceCooldown = true

    local Velocity =
        Root.AssemblyLinearVelocity

    Root.AssemblyLinearVelocity =
        Vector3.new(
            Velocity.X,
            AutoBounceHeight,
            Velocity.Z
        )

    Humanoid:ChangeState(
        Enum.HumanoidStateType.Jumping
    )

    task.delay(
        0.15,
        function()
            AutoBounceCooldown = false
        end
    )
end

local function StartAutoBounce()
    if AutoBounceConnection then
        AutoBounceConnection:Disconnect()
        AutoBounceConnection = nil
    end

    AutoBounceConnection =
        RunService.Heartbeat:Connect(
            function()
                if not AutoBounce then
                    return
                end

                local Character,
                    Humanoid,
                    Root =
                    GetCharacterData()

                if not Character
                    or not Humanoid
                    or not Root then
                    return
                end

                if Humanoid.Health <= 0 then
                    return
                end

                local State =
                    Humanoid:GetState()

                local Falling =
                    State
                        == Enum.HumanoidStateType.Freefall
                    or State
                        == Enum.HumanoidStateType.FallingDown

                if not Falling then
                    return
                end

                local VerticalVelocity =
                    Root.AssemblyLinearVelocity.Y

                if VerticalVelocity >= 0 then
                    return
                end

                local Distance =
                    CheckGroundDistance(
                        Character,
                        Root
                    )

                if Distance
                    and Distance
                        <= AutoBounceDistance then

                    DoAutoBounce(
                        Humanoid,
                        Root
                    )
                end
            end
        )
end

local function SetAutoBounce(
    Value
)
    AutoBounce = Value

    if Value then
        StartAutoBounce()
    else
        if AutoBounceConnection then
            AutoBounceConnection:Disconnect()
            AutoBounceConnection = nil
        end

        AutoBounceCooldown = false
    end
end

StartAutoBounce()

