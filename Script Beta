        TimerLabel.Size = UDim2.new(0, 220, 0, 50)
        TimerLabel.BackgroundTransparency = 1
        TimerLabel.BorderSizePixel = 0
        TimerLabel.Text = "--:--"
        TimerLabel.TextColor3 = Color3.new(1, 1, 1)
        TimerLabel.TextSize = 30
        TimerLabel.Font = Enum.Font.GothamBold
        TimerLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        TimerLabel.TextStrokeTransparency = 0.3
        TimerLabel.TextXAlignment = Enum.TextXAlignment.Center
        TimerLabel.TextYAlignment = Enum.TextYAlignment.Center
        TimerLabel.Parent = TimerGui

        --// สถานะของ Timer แต่ละตัว
        local PreviousText = {}
        local LastChanged = {}
        local Candidates = {}
        local SelectedTimer = nil

        TimerWorker = task.spawn(function()
            while TimerEnabled and TimerGui and TimerGui.Parent do
                local Success, ErrorMessage = pcall(function()
                    local Now = os.clock()
                    local FoundNow = {}

                    --// หา TextLabel ชื่อ Timer ทั้งหมด
                    for _, Obj in ipairs(TimerPlayerGui:GetDescendants()) do
                        if Obj:IsA("TextLabel") and Obj.Name == "Timer" and typeof(Obj.Text) == "string" then
                            FoundNow[Obj] = true

                            if PreviousText[Obj] == nil then
                                PreviousText[Obj] = Obj.Text
                                LastChanged[Obj] = Now
                            elseif PreviousText[Obj] ~= Obj.Text then
                                PreviousText[Obj] = Obj.Text
                                LastChanged[Obj] = Now

                                Candidates[Obj] = {
                                    ChangedAt = Now
                                }
                            end

                            if LastChanged[Obj]
                                and Now - LastChanged[Obj] <= TimerStableTime then
                                Candidates[Obj] = Candidates[Obj] or {
                                    ChangedAt = LastChanged[Obj]
                                }
                            end
                        end
                    end

                    --// ล้าง Instance ที่ถูกลบ
                    for Obj in pairs(PreviousText) do
                        if not FoundNow[Obj] then
                            PreviousText[Obj] = nil
                            LastChanged[Obj] = nil
                            Candidates[Obj] = nil

                            if SelectedTimer == Obj then
                                SelectedTimer = nil
                            end
                        end
                    end

                    --// เลือก Timer ที่เปลี่ยนข้อความล่าสุด
                    local Best, BestTime

                    for Obj, Info in pairs(Candidates) do
                        if FoundNow[Obj]
                            and Now - Info.ChangedAt <= TimerStableTime then
                            if not BestTime or Info.ChangedAt > BestTime then
                                Best = Obj
                                BestTime = Info.ChangedAt
                            end
                        else
                            Candidates[Obj] = nil
                        end
                    end

                    if Best then
                        SelectedTimer = Best
                    end

                    if SelectedTimer and FoundNow[SelectedTimer] then
                        TimerLabel.Text = SelectedTimer.Text
                    else
                        SelectedTimer = nil
                        TimerLabel.Text = "--:--"
                    end
                end)

                if not Success then
                    warn("[KRYVEX Timer]", ErrorMessage)
                end

                task.wait(TimerScanInterval)
            end
        end)

        Window:Notify({
            Title = "KRYVEX HUB",
            Content = "เปิด Live Timer แล้ว",
            Duration = 3
        })
    end

    --// เพิ่มในหมวดเมนูหลัก
    MainTab:CreateSection("ข้อมูลรอบ")

    MainTab:CreateToggle({
        Name = "แสดงเวลาในเกม",
        Default = false,
        Callback = function(Value)
            if Value then
                StartLiveTimer()
            else
                StopLiveTimer()

                Window:Notify({
                    Title = "KRYVEX HUB",
                    Content = "ปิด Live Timer แล้ว",
                    Duration = 3
                })
            end
        end
    })
end)


