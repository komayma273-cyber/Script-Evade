    local function StartFly()
        local Character = LocalPlayer.Character

        if not Character then
            return
        end

        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        local Root = Character:FindFirstChild("HumanoidRootPart")
        local Camera = workspace.CurrentCamera

        if not Humanoid or not Root or not Camera then
            return
        end

        if FlyForce then
            FlyForce:Destroy()
            FlyForce = nil
        end

        if FlySpin then
            FlySpin:Destroy()
            FlySpin = nil
        end

        FlyForce = Instance.new("BodyVelocity")
        FlyForce.Velocity = Vector3.zero
        FlyForce.P = 1000
        FlyForce.MaxForce = Vector3.new(
            FlyForce.P,
            FlyForce.P,
            FlyForce.P
        ) * 100
        FlyForce.Parent = Root

        FlySpin = Instance.new("BodyGyro")
        FlySpin.P = 10000
        FlySpin.MaxTorque = Vector3.new(
            FlySpin.P,
            FlySpin.P,
            FlySpin.P
        ) * 100
        FlySpin.CFrame = Root.CFrame
        FlySpin.Parent = Root

        Humanoid.PlatformStand = true
        Humanoid.AutoRotate = false
        Humanoid:ChangeState(
            Enum.HumanoidStateType.Freefall
        )

        FlyConnection = RunService.Heartbeat:Connect(function()
            if not FlyEnabled then
                return
            end

            if not Root.Parent or not Humanoid.Parent then
                StopFly()
                return
            end

            local CurrentCamera = workspace.CurrentCamera

            if not CurrentCamera then
                return
            end

            local Push = Vector3.zero

            local FV = CurrentCamera.CFrame:VectorToWorldSpace(
                Vector3.new(0, 0, -1)
            )

            local SV = CurrentCamera.CFrame:VectorToWorldSpace(
                Vector3.new(-1, 0, 0)
            )

            local CoFrame = CurrentCamera.CFrame

            local FlatLook = Vector3.new(
                CoFrame.LookVector.X,
                0,
                CoFrame.LookVector.Z
            )

            if FlatLook.Magnitude > 0 then
                FlatLook = FlatLook.Unit
            end

            local CV = CFrame.new(
                Vector3.zero,
                FlatLook
            ):VectorToObjectSpace(
                Humanoid.MoveDirection
            )

            Push = Push + (
                FV * (60 * FlySpeed) * -CV.Z
            )

            Push = Push + (
                SV * (40 * FlySpeed) * -CV.X
            )

            FlySpin.CFrame = CFrame.new(
                Vector3.zero,
                FV
            )

            FlyForce.Velocity =
                FlyForce.Velocity:Lerp(
                    Push,
                    0.2
                )

            if not Humanoid.PlatformStand then
                Humanoid.PlatformStand = true
            end

            if Humanoid.AutoRotate then
                Humanoid.AutoRotate = false
            end
        end)
    end

