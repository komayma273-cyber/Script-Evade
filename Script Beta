local function GetFloatingGui()
    if FloatingGui
        and FloatingGui.Parent then

        return FloatingGui
    end

    pcall(function()
        local Hui = gethui()

        if Hui then
            local Old = Hui:FindFirstChild(
                GUI_NAME
            )

            if Old then
                Old:Destroy()
            end

            FloatingGui = New(
                "ScreenGui",
                {
                    Name = GUI_NAME,
                    ResetOnSpawn = false,
                    IgnoreGuiInset = true,
                    ZIndexBehavior =
                        Enum.ZIndexBehavior.Sibling,
                },
                Hui
            )
        end
    end)

    if not FloatingGui then
        FloatingGui = New(
            "ScreenGui",
            {
                Name = GUI_NAME,
                ResetOnSpawn = false,
                IgnoreGuiInset = true,
                ZIndexBehavior =
                    Enum.ZIndexBehavior.Sibling,
            },
            game:GetService("CoreGui")
        )
    end

    return FloatingGui
end

local function RemoveFloatingButton(Name)
    local Data = FloatingButtons[Name]

    if Data then
        Data:Destroy()
        FloatingButtons[Name] = nil
    end

    local Count = 0

    for _ in pairs(FloatingButtons) do
        Count += 1
    end

    if Count == 0
        and FloatingGui then

        FloatingGui:Destroy()
        FloatingGui = nil
    end
end

