do
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local Player = Players.LocalPlayer
    local PlayerGui = Player:WaitForChild("PlayerGui")

    local SetPlayerMode = ReplicatedStorage
        :WaitForChild("Events")
        :WaitForChild("SetPlayerMode")

    local RESPAWN_DELAY = 3.5
    local AutoRespawnEnabled = false
    local RespawnMode = "สปาวปกติ"
    local SavedRespawnCFrame = nil

    local ProcessedCharacters = setmetatable({}, {__mode = "k"})
    local CharacterConnections = {}

    --=====================================================
    -- SAVE POSITION
    --=====================================================

    local function SaveRespawnPosition()
        local Character = Player.Character
        if not Character then return false end

        local Root = Character:FindFirstChild("HumanoidRootPart")
        if not Root then return false end

        SavedRespawnCFrame = Root.CFrame
        return true
    end

    --=====================================================
    -- FIND VISIBLE MENU
    --=====================================================

    local function IsMenuVisible()
        for _, Instance in ipairs(PlayerGui:GetDescendants()) do
            if Instance.Name == "Menu" then
                local Visible = true
                local Parent = Instance

                while Parent and Parent ~= PlayerGui do
                    if Parent:IsA("ScreenGui") then
                        if not Parent.Enabled then
                            Visible = false
                            break
                        end
                    elseif Parent:IsA("GuiObject") then
                        if not Parent.Visible then
                            Visible = false
                            break
                        end
                    end

                    Parent = Parent.Parent
                end

                if Visible then
                    return true
                end
            end
        end

        return false
    end

    --=====================================================
    -- DEATH / AUTO RESPAWN
    --=====================================================

    local function HandleDeath(Character, Humanoid)
        if not AutoRespawnEnabled then return end
        if ProcessedCharacters[Character] then return end
        if Humanoid.Health > 0 then return end

        ProcessedCharacters[Character] = true

        task.delay(RESPAWN_DELAY, function()
            if not AutoRespawnEnabled then return end
            if Player.Character ~= Character then return end
            if not Humanoid.Parent or Humanoid.Health > 0 then return end

            if IsMenuVisible() then
                Window:Notify({
                    Title = "KRYVEX HUB",
                    Content = "พบ Menu GUI ยกเลิกการเกิดใหม่",
                    Duration = 3
                })
                return
            end

            local Success = pcall(function()
                SetPlayerMode:FireServer(true)
            end)

            if not Success then
                Window:Notify({
                    Title = "KRYVEX HUB",
                    Content = "ส่งสัญญาณเกิดใหม่ไม่สำเร็จ",
                    Duration = 3
                })
            end
        end)
    end

    --=====================================================
    -- CHARACTER SETUP
    --=====================================================

    local function WatchCharacter(Character)
        task.spawn(function()
            local Humanoid = Character:WaitForChild("Humanoid", 10)
            if not Humanoid then return end

            local Connection = Humanoid.HealthChanged:Connect(function(Health)
                if Health <= 0 then
                    HandleDeath(Character, Humanoid)
                end
            end)

            CharacterConnections[Character] = Connection

            if Humanoid.Health <= 0 then
                HandleDeath(Character, Humanoid)
            end

            -- Restore saved position after respawn
            if RespawnMode == "สปาวจุดเดิม" and SavedRespawnCFrame then
                local Root = Character:WaitForChild("HumanoidRootPart", 10)

                if Root and Player.Character == Character then
                    task.wait(0.15)

                    if Player.Character == Character
                        and Humanoid.Health > 0 then
                        Root.CFrame = SavedRespawnCFrame
                    end
                end
            end
        end)
    end

    Player.CharacterAdded:Connect(WatchCharacter)

    if Player.Character then
        WatchCharacter(Player.Character)
    end

    --=====================================================
    -- UI
    --=====================================================

    MainTab:CreateSection("ออโต้รีสปาว")

    MainTab:CreateToggle({
        Name = "ออโต้รีสปาว",
        Default = false,

        Callback = function(Value)
            AutoRespawnEnabled = Value

            if Value then
                local Character = Player.Character
                local Humanoid = Character
                    and Character:FindFirstChildOfClass("Humanoid")

                if Humanoid and Humanoid.Health <= 0 then
                    HandleDeath(Character, Humanoid)
                end
            end

            Window:Notify({
                Title = "KRYVEX HUB",
                Content = Value
                    and ("เปิดออโต้รีสปาว | " .. RespawnMode)
                    or "ปิดออโต้รีสปาว",
                Duration = 3
            })
        end
    })

    MainTab:CreateDropdown({
        Name = "เลือกการสปาว",
        Options = {
            "สปาวปกติ",
            "สปาวจุดเดิม"
        },
        Default = "สปาวปกติ",

        Callback = function(Value)
            local Option = Value

            if typeof(Value) == "table" then
                Option = Value[1]
            end

            if typeof(Option) ~= "string" then
                return
            end

            RespawnMode = Option

            if RespawnMode == "สปาวจุดเดิม" then
                local Saved = SaveRespawnPosition()

                Window:Notify({
                    Title = "KRYVEX HUB",
                    Content = Saved
                        and "บันทึกตำแหน่งเกิดแล้ว"
                        or "ยังไม่สามารถบันทึกตำแหน่งได้",
                    Duration = 3
                })
            else
                Window:Notify({
                    Title = "KRYVEX HUB",
                    Content = "เลือกสปาวปกติแล้ว",
                    Duration = 3
                })
            end
        end
    })
end


