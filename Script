    local function ToggleClickTeleport(State)
        Enabled = State

        if Connection then
            Connection:Disconnect()
            Connection = nil
        end

        if not Enabled then
            return
        end

        Connection = UIS.InputBegan:Connect(function(Input, Processed)
            if Processed or not Enabled then
