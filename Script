--=========================================================
-- KRYVEX HUB | LOW GRAPHICS
-- Batch Scan + Material Correction
--=========================================================

do
    local LowGraphicsEnabled = false
    local LowGraphicsConnection = nil
    local LowGraphicsWorker = false

    local ScanInterval = 1.5
    local BatchSize = 100

    local function OptimizePart(Object)
        if not LowGraphicsEnabled then
            return
        end

        if not Object:IsA("BasePart") then
            return
        end

        pcall(function()
            if Object.Material ~= Enum.Material.SmoothPlastic then
                Object.Material = Enum.Material.SmoothPlastic
            end

            if Object.Reflectance ~= 0 then
                Object.Reflectance = 0
            end
        end)
    end

    --=====================================================
    -- BATCH SCAN ENTIRE MAP
    --=====================================================

    local function ScanWorkspace()
        if LowGraphicsWorker then
            return
        end

        LowGraphicsWorker = true

        task.spawn(function()
            local Success, ErrorMessage = pcall(function()
                local Objects = workspace:GetDescendants()
                local Index = 1

                while LowGraphicsEnabled and Index <= #Objects do
                    local EndIndex = math.min(
                        Index + BatchSize - 1,
                        #Objects
                    )

                    for i = Index, EndIndex do
                        if not LowGraphicsEnabled then
                            break
                        end

                        OptimizePart(Objects[i])
                    end

                    Index = EndIndex + 1

                    -- Yield between batches to reduce frame spikes
                    task.wait()
                end
            end)

            LowGraphicsWorker = false

            if not Success then
                warn("[KRYVEX LowGraphics] Scan error:", ErrorMessage)
            end
        end)
    end

    --=====================================================
    -- START
    --=====================================================

    local function StartLowGraphics()
        LowGraphicsEnabled = true

        if LowGraphicsConnection then
            LowGraphicsConnection:Disconnect()
            LowGraphicsConnection = nil
        end

        -- Handle newly added parts
        LowGraphicsConnection = workspace.DescendantAdded:Connect(function(Object)
            if not LowGraphicsEnabled then
                return
            end

            task.defer(function()
                OptimizePart(Object)
            end)
        end)

        ScanWorkspace()

        -- Periodically rescan in case the game restores materials
        task.spawn(function()
            while LowGraphicsEnabled do
                task.wait(ScanInterval)

                if LowGraphicsEnabled then
                    ScanWorkspace()
                end
            end
        end)
    end

    --=====================================================
    -- STOP
    --=====================================================

    local function StopLowGraphics()
        LowGraphicsEnabled = false

        if LowGraphicsConnection then
            LowGraphicsConnection:Disconnect()
            LowGraphicsConnection = nil
        end
    end

    --=====================================================
    -- UI
    --=====================================================

    OtherTab:CreateSection("ประสิทธิภาพ")

    OtherTab:CreateToggle({
        Name = "ลดกราฟฟิค",
        Default = false,

        Callback = function(Value)
            if Value then
                StartLowGraphics()
            else
                StopLowGraphics()
            end

            Window:Notify({
                Title = "KRYVEX HUB",
                Content = Value
                    and "เปิดลดกราฟฟิคแล้ว"
                    or "ปิดลดกราฟฟิคแล้ว",
                Duration = 3
            })
        end
    })
end


