        --// สร้าง UI โปร่งใส
        TimerGui = Instance.new("ScreenGui")
        TimerGui.Name = "KRYVEXLiveTimerDisplay"
        TimerGui.ResetOnSpawn = false
        TimerGui.IgnoreGuiInset = true
        TimerGui.DisplayOrder = 100
        TimerGui.Parent = TimerPlayerGui

        TimerLabel = Instance.new("TextLabel")
        TimerLabel.Name = "TimerDisplay"
        TimerLabel.AnchorPoint = Vector2.new(0.5, 0)
        TimerLabel.Position = UDim2.new(0.5, 0, 0.08, 0)
        TimerLabel.Size = UDim2.new(0, 220, 0, 50)
        TimerLabel.BackgroundTransparency = 1
        TimerLabel.BorderSizePixel = 0
        TimerLabel.Text = "--:--"
        TimerLabel.TextColor3 = Color3.new(1, 1, 1)
        TimerLabel.TextSize = 30
        TimerLabel.Font = Enum.Font.GothamBold
        TimerLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        TimerLabel.TextStrokeTransparency = 0.3
        TimerLabel.TextXAlignment = Enum.TextXAlignment.Center
        TimerLabel.TextYAlignment = Enum.TextYAlignment.Center
        TimerLabel.Parent = TimerGui

        --// สถานะของ Timer แต่ละตัว
        local PreviousText = {}
        local LastChanged = {}
        local Candidates = {}
        local SelectedTimer = nil

        TimerWorker = task.spawn(function()
            while TimerEnabled and TimerGui and TimerGui.Parent do
                local Success, ErrorMessage = pcall(function()
                    local Now = os.clock()
                    local FoundNow = {}

                    --// หา TextLabel ชื่อ Timer ทั้งหมด
                    for _, Obj in ipairs(TimerPlayerGui:GetDescendants()) do
                        if Obj:IsA("TextLabel") and Obj.Name == "Timer" and typeof(Obj.Text) == "string" then
                            FoundNow[Obj] = true

                            if PreviousText[Obj] == nil then
                                PreviousText[Obj] = Obj.Text
                                LastChanged[Obj] = Now
                            elseif PreviousText[Obj] ~= Obj.Text then
                                PreviousText[Obj] = Obj.Text
                                LastChanged[Obj] = Now

                                Candidates[Obj] = {
                                    ChangedAt = Now
                                }
                            end

                            if LastChanged[Obj]
                                and Now - LastChanged[Obj] <= TimerStableTime then
                                Candidates[Obj] = Candidates[Obj] or {
                                    ChangedAt = LastChanged[Obj]
                                }
                            end
                        end
                    end

                    --// ล้าง Instance ที่ถูกลบ
                    for Obj in pairs(PreviousText) do
                        if not FoundNow[Obj] then
                            PreviousText[Obj] = nil
                            LastChanged[Obj] = nil
                            Candidates[Obj] = nil

                            if SelectedTimer == Obj then
                                SelectedTimer = nil
                            end
                        end
                    end

                    --// เลือก Timer ที่เปลี่ยนข้อความล่าสุด
                    local Best, BestTime

                    for Obj, Info in pairs(Candidates) do
                        if FoundNow[Obj]
                            and Now - Info.ChangedAt <= TimerStableTime then
                            if not BestTime or Info.ChangedAt > BestTime then
                                Best = Obj
                                BestTime = Info.ChangedAt
                            end
                        else
                            Candidates[Obj] = nil
                        end
                    end

                    if Best then
                        SelectedTimer = Best
                    end

                    if SelectedTimer and FoundNow[SelectedTimer] then
                        TimerLabel.Text = SelectedTimer.Text
                    else
                        SelectedTimer = nil
                        TimerLabel.Text = "--:--"
                    end
                end)

                if not Success then
                    warn("[KRYVEX Timer]", ErrorMessage)
                end

                task.wait(TimerScanInterval)
            end
        end)

        Window:Notify({
            Title = "KRYVEX HUB",
            Content = "เปิด Live Timer แล้ว",
            Duration = 3
        })
    end

    --// เพิ่มในหมวดเมนูหลัก
    MainTab:CreateSection("ข้อมูลรอบ")

    MainTab:CreateToggle({
        Name = "แสดงเวลาในเกม",
        Default = false,
        Callback = function(Value)
            if Value then
                StartLiveTimer()
            else
                StopLiveTimer()

                Window:Notify({
                    Title = "KRYVEX HUB",
                    Content = "ปิด Live Timer แล้ว",
                    Duration = 3
                })
            end
        end
    })
end)


--// =========================================================
--// KRYVEX HUB | MAP SCALE CONTROLLER
--// Map Scale + Teleport On Part
--// =========================================================

do
local __MapOk, __MapErr = pcall(function()

    local Workspace = game:GetService("Workspace")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local _Window = Window
    local _Tab = MapTab

    if not _Window then
        warn("[KRYVEX MAP] ไม่พบ Window")
        return
    end

    if not _Tab then
        local Success, Result = pcall(function()
            return _Window:CreateTab("แมพ", "map")
        end)

        if Success and Result then
            _Tab = Result
        else
            warn("[KRYVEX MAP] สร้างแท็บแมพไม่สำเร็จ")
            return
        end
    end

    local function Notify(Content)
        pcall(function()
            _Window:Notify({
                Title = "KRYVEX MAP",
                Content = Content,
                Duration = 3
            })
        end)
    end

    --=========================================================
    -- SETTINGS
    --=========================================================

    local MapScaleEnabled = false
    local MapScale = 2

    local MapOriginal = {}
    local MapParts = {}
    local MapCenter = Vector3.zero
    local MapTarget = nil

    --=========================================================
    -- FIND MAP
    --=========================================================

    local function FindMap()
        local GameFolder = Workspace:FindFirstChild("Game")

        if GameFolder then
            local Map = GameFolder:FindFirstChild("Map")

            if Map then
                return Map
            end
        end

        return Workspace:FindFirstChild("Map", true)
    end

    --=========================================================
    -- RESTORE MAP
    --=========================================================

    local function RestoreMap()
        for Part, Data in pairs(MapOriginal) do
            if Part and Part.Parent then
                pcall(function()
                    Part.Size = Data.Size
                    Part.CFrame = Data.CFrame
                end)
            end
        end
    end

    --=========================================================
    -- CAPTURE MAP
    --=========================================================

    local function CaptureMap()
        RestoreMap()

        MapTarget = FindMap()
        MapOriginal = {}
        MapParts = {}

        if not MapTarget then
            return false, "ไม่พบ Instance ชื่อ Map"
        end

        for _, Object in ipairs(MapTarget:GetDescendants()) do
            if Object:IsA("BasePart") then
                table.insert(MapParts, Object)

                MapOriginal[Object] = {
                    Size = Object.Size,
                    CFrame = Object.CFrame
                }
            end
        end

        if #MapParts == 0 then
            return false, "ไม่พบชิ้นส่วนภายใน Map"
        end

        local Sum = Vector3.zero

        for _, Part in ipairs(MapParts) do
            Sum += Part.Position
        end

        MapCenter = Sum / #MapParts

        return true, "พบชิ้นส่วนแมพ " .. #MapParts .. " ชิ้น"
    end

    --=========================================================
    -- APPLY MAP SCALE
    --=========================================================

    local function ApplyMapScale(Scale)
        if not MapTarget or not MapTarget.Parent then
            local Success, Message = CaptureMap()

            if not Success then
                Notify(Message)
                return false
            end
        end

        local Count = 0

        for _, Part in ipairs(MapParts) do
            local Data = MapOriginal[Part]

            if Part.Parent and Data then
                pcall(function()
                    local Offset = Data.CFrame.Position - MapCenter
                    local NewPosition = MapCenter + Offset * Scale
                    local Rotation = Data.CFrame - Data.CFrame.Position

                    Part.Size = Data.Size * Scale
                    Part.CFrame = CFrame.new(NewPosition) * Rotation
                end)

                Count += 1

                if Count % 300 == 0 then
                    task.wait()
                end
            end
        end

        return true
    end

    --=========================================================
    -- TELEPORT ON TOP OF MAP PART
    --=========================================================

    local function TeleportOnMapPart()
        local Character = LocalPlayer.Character
        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        local Humanoid = Character
            and Character:FindFirstChildOfClass("Humanoid")

        if not Root or not Humanoid then
            Notify("ไม่พบตัวละคร")
            return false
        end

        if not MapTarget or not MapTarget.Parent then
            Notify("ไม่พบแมพ")
            return false
        end

        local BestPart = nil
        local BestPosition = nil
        local BestDistance = math.huge

        for _, Part in ipairs(MapParts) do
            if Part.Parent and Part:IsA("BasePart") then
                local TopY = Part.Position.Y + Part.Size.Y / 2

                if Part.Size.X >= 4 and Part.Size.Z >= 4 then
                    local HalfX = Part.Size.X / 2
                    local HalfZ = Part.Size.Z / 2

                    local TargetPosition = Vector3.new(
                        math.clamp(
                            Root.Position.X,
                            Part.Position.X - HalfX + 2,
                            Part.Position.X + HalfX - 2
                        ),
                        TopY + 5,
                        math.clamp(
                            Root.Position.Z,
                            Part.Position.Z - HalfZ + 2,
                            Part.Position.Z + HalfZ - 2
                        )
                    )

                    local Distance =
                        (TargetPosition - Root.Position).Magnitude

                    if Distance < BestDistance then
                        BestDistance = Distance
                        BestPart = Part
                        BestPosition = TargetPosition
                    end
                end
            end
        end

        if not BestPart or not BestPosition then
            Notify("หา Part สำหรับวาร์ปไม่เจอ")
            return false
        end

        Character:PivotTo(CFrame.new(BestPosition))

        return true
    end

    --=========================================================
    -- UI: MAP SCALE
    --=========================================================

    _Tab:CreateSection("Map Scale")

    _Tab:CreateToggle({
        Name = "เปิดใช้งานขยายแมพ",
        Default = false,

        Callback = function(Value)
            if Value then
                local Success, Message = CaptureMap()

                if not Success then
                    Notify(Message)
                    return
                end

                MapScaleEnabled = true

                local Scaled = ApplyMapScale(MapScale)

                if not Scaled then
                    MapScaleEnabled = false
                    return
                end

                task.wait(0.2)

                if TeleportOnMapPart() then
                    Notify(
                        "ขยายแมพ x" .. MapScale
                        .. " และวาร์ปไปบน Part แล้ว"
                    )
                end
            else
                MapScaleEnabled = false
                RestoreMap()

                Notify("คืนขนาดแมพเดิมแล้ว")
            end
        end
    })

    --=========================================================
    -- UI: SCALE SLIDER
    --=========================================================

    _Tab:CreateSlider({
        Name = "ขนาดแมพ",
        Min = 1,
        Max = 5,
        Default = 2,
        Increment = 0.5,

        Callback = function(Value)
            MapScale = Value

            if MapScaleEnabled then
                ApplyMapScale(MapScale)
            end
        end
    })

    --=========================================================
    -- UI: RESTORE BUTTON
    --=========================================================

    _Tab:CreateButton({
        Name = "คืนขนาดแมพเดิม",

        Callback = function()
            RestoreMap()
            MapScaleEnabled = false

            Notify("คืนขนาดแมพเดิมแล้ว")
        end
    })

    --=========================================================
    -- UI: TELEPORT BUTTON
    --=========================================================

    _Tab:CreateButton({
        Name = "วาร์ปไปบน Part",

        Callback = function()
            if TeleportOnMapPart() then
                Notify("วาร์ปไปบน Part สำเร็จ")
            end
        end
    })

    print("[KRYVEX MAP] Map Scale Controller loaded")

end)

if not __MapOk then
    warn("[KRYVEX MAP] Error: " .. tostring(__MapErr))
end
end



